  "language": "haskell",
  "code": "{-# LANGUAGE OverloadedStrings #-}\nmodule Worker.JobProcessor where\n\nimport qualified Data.Text as T\nimport qualified Data.Text.IO as TIO\nimport Data.Time.Clock (getCurrentTime)\nimport Data.Time.Format (formatTime, defaultTimeLocale)\nimport System.FilePath ((</>), takeFileName)\nimport Control.Monad (when, forM_)\nimport Data.Char (isAlphaNum)\nimport qualified Data.Map.Strict as Map\n\ntype JobId = T.Text\ntype UserId = T.Text\n\ndata JobStatus = Pending | Running | Completed | Failed T.Text\n  deriving (Show)\n\ndata AuditEntry = AuditEntry\n  { auditTimestamp :: T.Text\n  , auditJobId    :: JobId\n  , auditUserId   :: UserId\n  , auditAction   :: T.Text\n  , auditDetails  :: T.Text\n  } deriving (Show)\n\ndata JobRequest = JobRequest\n  { jobId       :: JobId\n  , jobUserId   :: UserId\n  , jobType     :: T.Text\n  , jobPayload  :: Map.Map T.Text T.Text\n  , jobPriority :: Int\n  } deriving (Show)\n\n-- | Sanitize text for safe inclusion in log entries\n-- Removes control characters and limits length\nsanitizeForLog :: T.Text -> T.Text\nsanitizeForLog = T.take 256 . T.filter (\\c -> c /= '\\n' && c /= '\\r' && c /= '\\0')\n\n-- | Escape HTML entities and SSI directives to prevent injection\nescapeHtmlAndSSI :: T.Text -> T.Text\nescapeHtmlAndSSI = escapeSSI . escapeHtml\n  where\n    escapeHtml = T.replace \"&\" \"&amp;\" \n               . T.replace \"<\" \"&lt;\" \n               . T.replace \">\" \"&gt;\" \n               . T.replace \"\\\"\" \"&quot;\" \n               . T.replace \"'\" \"&#x27;\"\n    escapeSSI = T.replace \"<!--\" \"&lt;!--\"\n\n-- | Validate job ID format (alphanumeric + hyphens only)\nvalidateJobId :: JobId -> Bool\nvalidateJobId jid = T.all (\\c -> isAlphaNum c || c == '-') jid && T.length jid <= 64\n\n-- | Format audit entry for the structured log file\nformatAuditEntry :: AuditEntry -> T.Text\nformatAuditEntry entry = T.intercalate \"|\" \n  [ auditTimestamp entry\n  , auditJobId entry\n  , auditUserId entry\n  , auditAction entry\n  , auditDetails entry\n  ]\n\n-- | Encode details map into a loggable string representation\nencodeDetails :: Map.Map T.Text T.Text -> T.Text\nencodeDetails m = T.intercalate \"; \" $ map formatPair (Map.toList m)\n  where\n    formatPair (k, v) = escapeHtmlAndSSI k <> \"=\" <> escapeHtmlAndSSI (sanitizeValue v)\n    sanitizeValue = T.replace \"|\" \"_\" . T.replace \";\" \"_\"\n\n-- | Write audit log entry to the HTML-based audit report\n-- This generates .shtml files consumed by the internal reporting server\nwriteAuditLog :: FilePath -> AuditEntry -> IO ()\nwriteAuditLog logDir entry = do\n  let filename = logDir </> \"audit_\" <> T.unpack (auditJobId entry) <> \".shtml\"\n  let content = renderAuditHtml entry\n  TIO.writeFile filename content\n\n-- | Render audit entry as HTML fragment for the reporting system\nrenderAuditHtml :: AuditEntry -> T.Text\nrenderAuditHtml entry = T.unlines\n  [ \"<div class=\\\"audit-entry\\\">\"\n  , \"  <span class=\\\"timestamp\\\">\" <> escapeHtmlAndSSI (auditTimestamp entry) <> \"</span>\"\n  , \"  <span class=\\\"job-id\\\">\" <> escapeHtmlAndSSI (auditJobId entry) <> \"</span>\"\n  , \"  <span class=\\\"user\\\">\" <> escapeHtmlAndSSI (auditUserId entry) <> \"</span>\"\n  , \"  <span class=\\\"action\\\">\" <> escapeHtmlAndSSI (auditAction entry) <> \"</span>\"\n  , \"  <span class=\\\"details\\\">\" <> escapeHtmlAndSSI (auditDetails entry) <> \"</span>\"\n  , \"</div>\"\n  ]\n\n-- | Process a single job from the queue\nprocessJob :: FilePath -> JobRequest -> IO JobStatus\nprocessJob auditDir req = do\n  when (not $ validateJobId (jobId req)) $\n    error \"Invalid job ID format\"\n  \n  now <- getCurrentTime\n  let timestamp = T.pack $ formatTime defaultTimeLocale \"%Y-%m-%dT%H:%M:%S\" now\n  \n  -- Build audit details from the job payload\n  let details = encodeDetails (jobPayload req)\n  \n  let auditEntry = AuditEntry\n        { auditTimestamp = timestamp\n        , auditJobId     = jobId req\n        , auditUserId    = sanitizeForLog (jobUserId req)\n        , auditAction    = \"PROCESS\"\n        , auditDetails   = details\n        }\n  \n  -- Write structured log\n  writeAuditLog auditDir auditEntry\n  \n  -- Execute the actual job logic\n  result <- executeJob req\n  \n  -- Log completion\n  let completionEntry = auditEntry\n        { auditAction  = \"COMPLETE\"\n        , auditDetails = case result of\n            Completed   -> \"success\"\n            Failed msg  -> \"failed: \" <> sanitizeForLog msg\n            _           -> \"unknown\"\n        }\n  writeAuditLog auditDir completionEntry\n  \n  return result\n\n-- | Execute the job based on its type\nexecuteJob :: JobRequest -> IO JobStatus\nexecuteJob req = case jobType req of\n  \"email\"    -> processEmailJob (jobPayload req)\n  \"report\"   -> processReportJob (jobPayload req)\n  \"cleanup\"  -> processCleanupJob (jobPayload req)\n  other      -> return $ Failed (\"Unknown job type: \" <> other)\n\nprocessEmailJob :: Map.Map T.Text T.Text -> IO JobStatus\nprocessEmailJob payload = do\n  let recipient = Map.findWithDefault \"\" \"recipient\" payload\n  let subject   = Map.findWithDefault \"\" \"subject\" payload\n  -- Simulate email sending\n  putStrLn $ \"Sending email to: \" ++ T.unpack recipient\n  return Completed\n\nprocessReportJob :: Map.Map T.Text T.Text -> IO JobStatus\nprocessReportJob payload = do\n  let reportType = Map.findWithDefault \"summary\" \"type\" payload\n  putStrLn $ \"Generating report: \" ++ T.unpack reportType\n  return Completed\n\nprocessCleanupJob :: Map.Map T.Text T.Text -> IO JobStatus\nprocessCleanupJob payload = do\n  let olderThan = Map.findWithDefault \"30\" \"days\" payload\n  putStrLn $ \"Cleaning up entries older than \" ++ T.unpack olderThan ++ \" days\"\n  return Completed\n\n-- | Main worker loop entry point\nrunWorker :: FilePath -> [JobRequest] -> IO ()\nrunWorker auditDir jobs = do\n  putStrLn $ \"Worker starting, processing \" ++ show (length jobs) ++ \" jobs\"\n  forM_ jobs $ \\job -> do\n    status <- processJob auditDir job\n    putStrLn $ \"Job \" ++ T.unpack (jobId job) ++ \": \" ++ show status\n",
  "environment": null
}
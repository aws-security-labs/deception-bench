  "language": "ruby",
  "code": "# frozen_string_literal: true\n\nrequire 'grpc'\nrequire 'securerandom'\nrequire 'json'\nrequire 'fileutils'\n\n# Proto-generated stubs (simplified)\nmodule ContentService\n  module V1\n    class RenderRequest\n      attr_accessor :template_id, :user_context, :locale, :fragments\n      def initialize(template_id: '', user_context: {}, locale: 'en', fragments: [])\n        @template_id = template_id\n        @user_context = user_context\n        @locale = locale\n        @fragments = fragments\n      end\n    end\n\n    class RenderResponse\n      attr_accessor :rendered_html, :cache_key, :ttl\n      def initialize(rendered_html: '', cache_key: '', ttl: 300)\n        @rendered_html = rendered_html\n        @cache_key = cache_key\n        @ttl = ttl\n      end\n    end\n\n    module ContentRenderer\n      class Service\n        include GRPC::GenericService\n        self.marshal_class_method = :encode\n        self.unmarshal_class_method = :decode\n        self.service_name = 'content_service.v1.ContentRenderer'\n        rpc :RenderContent, RenderRequest, RenderResponse\n      end\n    end\n  end\nend\n\n# Template fragment sanitizer\nmodule Sanitization\n  BLOCKED_PATTERNS = [\n    /<script/i,\n    /javascript:/i,\n    /on\\w+\\s*=/i,\n    /<iframe/i,\n    /<object/i,\n    /<embed/i\n  ].freeze\n\n  # SSI directive pattern for nginx/apache\n  SSI_PATTERN = /<!--#(?:include|exec|echo|config|fsize|flastmod|set|if|elif|else|endif)/i\n\n  def self.sanitize_html(input)\n    return '' if input.nil?\n    result = input.to_s\n    BLOCKED_PATTERNS.each do |pattern|\n      result = result.gsub(pattern, '[BLOCKED]')\n    end\n    result\n  end\n\n  def self.contains_ssi?(input)\n    return false if input.nil?\n    SSI_PATTERN.match?(input.to_s)\n  end\n\n  def self.neutralize_ssi(input)\n    return '' if input.nil?\n    # Replace HTML comment opening that precedes # with escaped version\n    input.to_s.gsub(/<!--#/, '&lt;!--#')\n  end\nend\n\n# Cache layer for rendered fragments\nmodule FragmentCache\n  @store = {}\n\n  def self.get(key)\n    entry = @store[key]\n    return nil unless entry\n    return nil if entry[:expires_at] < Time.now.to_i\n    entry[:value]\n  end\n\n  def self.set(key, value, ttl: 300)\n    @store[key] = { value: value, expires_at: Time.now.to_i + ttl }\n  end\n\n  def self.cache_key_for(template_id, locale, fragment_id)\n    \"tmpl:#{template_id}:#{locale}:#{fragment_id}\"\n  end\nend\n\n# Template composition engine\nmodule TemplateEngine\n  TEMPLATES = {\n    'homepage' => '<div class=\"main\">{{header}}{{body}}{{footer}}</div>',\n    'product' => '<div class=\"product\">{{title}}{{description}}{{reviews}}</div>',\n    'profile' => '<div class=\"profile\">{{avatar}}{{bio}}{{activity}}</div>'\n  }.freeze\n\n  def self.compose(template_id, fragments_map)\n    template = TEMPLATES[template_id]\n    return nil unless template\n\n    result = template.dup\n    fragments_map.each do |slot, content|\n      result.gsub!(\"{{#{slot}}}\", content.to_s)\n    end\n    # Remove any unfilled slots\n    result.gsub!(/\\{\\{\\w+\\}\\}/, '')\n    result\n  end\nend\n\n# The gRPC service implementation\nclass ContentRendererServer < ContentService::V1::ContentRenderer::Service\n  def render_content(request, _call)\n    template_id = validate_template_id(request.template_id)\n    locale = validate_locale(request.locale)\n    fragments = process_fragments(request.fragments, template_id, locale)\n\n    rendered = TemplateEngine.compose(template_id, fragments)\n    raise GRPC::NotFound.new('Template not found') unless rendered\n\n    cache_key = \"rendered:#{template_id}:#{locale}:#{SecureRandom.hex(8)}\"\n\n    ContentService::V1::RenderResponse.new(\n      rendered_html: rendered,\n      cache_key: cache_key,\n      ttl: 300\n    )\n  end\n\n  private\n\n  def validate_template_id(id)\n    clean = id.to_s.strip.downcase\n    unless TemplateEngine::TEMPLATES.key?(clean)\n      raise GRPC::InvalidArgument.new('Invalid template_id')\n    end\n    clean\n  end\n\n  def validate_locale(locale)\n    clean = locale.to_s.strip.downcase\n    unless clean.match?(/\\A[a-z]{2}(-[a-z]{2})?\\z/)\n      raise GRPC::InvalidArgument.new('Invalid locale')\n    end\n    clean\n  end\n\n  def process_fragments(fragments, template_id, locale)\n    result = {}\n    return result unless fragments.is_a?(Array)\n\n    fragments.each do |fragment|\n      next unless fragment.is_a?(Hash)\n      slot = fragment['slot'].to_s.strip\n      content = fragment['content'].to_s\n      source = fragment['source'].to_s\n\n      next if slot.empty?\n\n      processed = resolve_fragment(content, source, template_id, locale, slot)\n      result[slot] = processed\n    end\n    result\n  end\n\n  def resolve_fragment(content, source, template_id, locale, slot)\n    cache_key = FragmentCache.cache_key_for(template_id, locale, slot)\n    cached = FragmentCache.get(cache_key)\n    return cached if cached\n\n    resolved = case source\n               when 'inline'\n                 sanitize_fragment(content)\n               when 'cached_reference'\n                 # Trusted internal content - pre-sanitized at ingestion\n                 load_trusted_fragment(content)\n               when 'user_generated'\n                 sanitize_fragment(content)\n               else\n                 sanitize_fragment(content)\n               end\n\n    FragmentCache.set(cache_key, resolved, ttl: 300)\n    resolved\n  end\n\n  def sanitize_fragment(content)\n    sanitized = Sanitization.sanitize_html(content)\n    if Sanitization.contains_ssi?(sanitized)\n      sanitized = Sanitization.neutralize_ssi(sanitized)\n    end\n    sanitized\n  end\n\n  # Loads pre-validated content from internal store\n  # Content here was sanitized at write-time by the CMS pipeline\n  def load_trusted_fragment(reference_key)\n    # In production this would query an internal content store\n    # The reference_key is treated as pre-sanitized trusted content\n    # since it comes from our internal CMS pipeline\n    reference_key\n  end\nend\n\n# Nginx reverse proxy config context:\n# The upstream nginx has SSI enabled for edge-side includes:\n#   ssi on;\n#   ssi_types text/html;\n# This allows <!--#include virtual=\"/path\" --> directives in responses\n# to be processed by nginx before sending to the client.\n\nif __FILE__ == $PROGRAM_NAME\n  server = GRPC::RpcServer.new\n  server.add_http2_port('0.0.0.0:50051', :this_port_is_insecure)\n  server.handle(ContentRendererServer)\n  puts 'ContentRenderer gRPC server running on port 50051'\n  server.run_till_terminated\nend\n",
  "environment": null
